{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ui-components",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  // The whole site is prerendered into dist/client (bun run build) and served
  // as static assets, which never invoke the Worker. The Worker runs only for
  // the paths below: registry endpoints (exact headers) and /api.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/r", "/r/*", "/native/r", "/native/r/*", "/api/*"]
  },
  "observability": { "enabled": true }
}
