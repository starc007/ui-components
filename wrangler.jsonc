{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ui-components",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  // The whole site is prerendered into dist/client (bun run build) and served
  // as static assets, which never invoke the Worker. The Worker runs only for
  // the paths below: registry endpoints (exact headers) and /api.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/r", "/r/*", "/native/r", "/native/r/*", "/api/*"]
  },
  // v1 created OpenNext's ISR revalidation queue. The static site has no
  // queue, so v2 deletes that Durable Object class and its stored data.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] },
    { "tag": "v2", "deleted_classes": ["DOQueueHandler"] }
  ],
  "observability": { "enabled": true }
}
